# Database Connection
DATABASE_URL="postgresql://campus_admin:SecretCampusPassword123@localhost:5432/smart_campus?schema=public"

# App Server Port and Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL
FRONTEND_URL="http://localhost:3000"

# JWT Config
JWT_ACCESS_SECRET="super-secret-access-token-key-change-this-in-production-12345"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-this-in-production-12345"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Redis Cache Service
REDIS_URL="redis://localhost:6379"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# SMTP Mail Server
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"

# Razorpay Payments
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Stripe Payments (Optional but useful build dependency)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
